   "source": [
    "class SimpleTokenizer:\n",
    "    def __init__(self, vocab):\n",
    "        self.vocab = vocab\n",
    "\n",
    "    def encode(self, text):\n",
    "        tokens = []\n",
    "        for word in text.lower().split():\n",
    "            tokens.append(self.vocab.get(word, self.vocab[\"<UNK>\"]))\n",
    "        return tokens\n"
   ]
  }
 ],
